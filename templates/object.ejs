<%- include('sub/head.ejs') %>
<body>
  <div class="container mt-4">
    <%- include('sub/objectHeader.ejs') %>
    <div class="p-3 mb-4 bg-light text-center">
      <h1><%= object.objName %></h1>
    </div>
    <div class="row">
      <div class="col-md-5 mb-3">
        <img src="/images/<%= object.image %>" alt="<%= object.objName %>" class="img-fluid img-thumbnail">
      </div>
      <div class="col-md-7">
        <p><%= object.descr %></p>
        <p><strong>Сучасна адреса:</strong> <%= object.curaddr %></p>
      </div>
    </div>
  </div>
</body>
</html>